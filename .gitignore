*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Terraform lock file
# Uncomment if you don't want to version it
# .terraform.lock.hcl

# Environment files
.env
.env.*

# VS Code
.vscode/

# IntelliJ
.idea/

# macOS
.DS_Store

# Windows
Thumbs.db

